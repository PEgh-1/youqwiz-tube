    "@fontsource/luckiest-guy": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@twemoji/svg": "^15.0.0",
    "googleapis": "^188.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
