{
  "name": "youqwiz-tube",
  "version": "0.1.0",
  "private": true,
  "description": "Chaîne YouTube YouQwiz — production automatisée (Remotion + GitHub Actions)",
  "type": "module",
  "scripts": {
    "tts": "node scripts/tts.mjs",
    "channel:render": "node scripts/render-channel.mjs",
    "channel:setup": "node scripts/setup-channel.mjs",
    "studio": "remotion studio src/index.ts",
    "generate": "node scripts/generate.mjs",
    "render": "node scripts/render.mjs",
    "qc": "node scripts/qc.mjs",
    "upload": "node scripts/upload.mjs",
    "chapters": "node scripts/chapters.mjs",
    "daily": "npm run generate && npm run tts && npm run chapters && npm run render && npm run qc && npm run upload",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
